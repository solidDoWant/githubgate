# The client image: only the static githubgate-client binary, mounted into
# pods as an image volume. `make build-images` cross-compiles the binary for
# each platform into build/images/<arch>/ first.
FROM scratch

ARG TARGETARCH
# Links the ghcr.io package to this repository (its visibility and README).
LABEL org.opencontainers.image.source="https://github.com/solidDoWant/githubgate"
COPY build/images/${TARGETARCH}/githubgate-client /githubgate-client
ENTRYPOINT ["/githubgate-client"]
