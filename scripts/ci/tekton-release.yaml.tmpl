# The template of the release PipelineRun, .tekton/release.yaml, written by
# scripts/ci/tekton-generate.sh (`make generate`).
#
# A version tag starts it: v<X.Y.Z> or v<X.Y.Z>-rc.<K>, pushed by the
# release-manager. It runs as ci-release, the only ServiceAccount whose
# rules in the CI cluster's registrygate (the owner's registry proxy) allow
# pushes to ghcr.io; the cluster refuses ci-release
# for any other event or ref. /retest is refused for it, so a release runs
# again only when its tag is pushed again, and every step is safe to repeat.
#
# There is no cancel-in-progress annotation: a release always runs to the end.
#
# publish runs code from the repository but holds no GitHub token and never
# sees a registry credential: the CI cluster's registrygate keeps it. Then
# github-release creates the GitHub release through githubgate's interceptor,
# which the CI cluster adds to every pod; githubgate allows ci-release only to
# fetch the repository, read the release and CHANGELOG.md, create a
# release of a v* tag, list its assets and upload assets to it. Only a version-tag push starts this run, so only what
# can push tags reaches that access.
apiVersion: tekton.dev/v1
kind: PipelineRun
metadata:
  # A fixed name collides with the previous run, which Pipelines-as-Code keeps.
  generateName: githubgate-release-
  annotations:
    pipelinesascode.tekton.dev/on-cel-expression: >-
      event == "push" && target_branch.matches("^refs/tags/v[0-9]+\\.[0-9]+\\.[0-9]+(-rc\\.[0-9]+)?$")
    pipelinesascode.tekton.dev/max-keep-runs: "10"
spec:
  params:
    - name: repo_url
      value: "{{ repo_url }}"
    - name: revision
      value: "{{ revision }}"
    - name: ref
      value: "{{ target_branch }}"
  timeouts:
    pipeline: 1h
  taskRunTemplate:
    serviceAccountName: ci-release
  workspaces:
    # Shared by the step and dockerd at the same path, so the stage container
    # can mount the checkout. It is a claim, not an emptyDir: github-release
    # reads the assets publish built, and every task's pod gets its own
    # emptyDir.
    - name: source
      volumeClaimTemplate:
        spec:
          accessModes:
            - ReadWriteOnce
          resources:
            requests:
              storage: 5Gi
  taskRunSpecs:
    # The stage runs inside the dind sidecar's cgroup: it cross-compiles four
    # binaries, scans them and assembles two images for two platforms. No CPU
    # limit: a kata VM's CPU request only places the pod and sets its share.
    - pipelineTaskName: publish
      sidecarSpecs:
        - name: dind
          computeResources:
            requests:
              cpu: "8"
              memory: 6Gi
            limits:
              memory: 6Gi
      stepSpecs:
        - name: run
          computeResources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              memory: 256Mi
  pipelineSpec:
    params:
      - name: repo_url
        type: string
      - name: revision
        type: string
      - name: ref
        type: string
    workspaces:
      - name: source
    tasks:
      - name: publish
        taskRef:
          resolver: cluster
          params:
            - name: kind
              value: task
            - name: name
              value: docker
            - name: namespace
              value: ci-tekton
        params:
          - name: script
            value: |
              set -eu
              # The trigger only matches version tags, so the ref is
              # refs/tags/v<version>; publish-release.sh checks it again.
              ref='$(params.ref)'
              version="${ref##*/}"
              mkdir src
              cd src
              git init -q .
              git remote add origin "$(params.repo_url)"
              git fetch -q --depth 1 origin "$(params.revision)"
              git checkout -q --detach "$(params.revision)"
              RELEASE_VERSION="${version#v}"
              export RELEASE_VERSION
              exec ./scripts/ci/stages.sh release
        workspaces:
          - name: source
            workspace: source
      # The GitHub release, once the images and chart are published. Notes are
      # exactly the `## <version>` section of CHANGELOG.md at the tag. Safe to
      # repeat: an existing release is left as it is.
      - name: github-release
        runAfter:
          - publish
        params:
          - name: ref
            value: $(params.ref)
        workspaces:
          - name: source
            workspace: source
        taskSpec:
          params:
            - name: ref
              type: string
          workspaces:
            - name: source
          steps:
            - name: release
              image: mirror.gcr.io/library/python:3.14.9@sha256:30a34d141e34b8fbedabecb8f86b3d49a62e348d8112ad3c1289f0b2b216ad3e
              computeResources:
                requests:
                  cpu: 100m
                  memory: 256Mi
                limits:
                  memory: 256Mi
              env:
                # Through the environment, not the script text.
                - name: REF
                  value: $(params.ref)
              script: |
                #!/usr/bin/env python3
                import json, os, re, subprocess, sys, urllib.error, urllib.parse, urllib.request
                tag = os.environ["REF"].rsplit("/", 1)[-1]
                if not re.fullmatch(r"v[0-9]+\.[0-9]+\.[0-9]+(-rc\.[0-9]+)?", tag):
                    sys.exit(f"not a version tag: {tag}")
                version = tag[1:]
                api = "https://api.github.com/repos/{{ repo_owner }}/{{ repo_name }}"
                def call(method, path, body=None, accept="application/vnd.github+json"):
                    request = urllib.request.Request(
                        api + path, method=method,
                        data=None if body is None else json.dumps(body).encode(),
                        headers={"Accept": accept},
                    )
                    with urllib.request.urlopen(request, timeout=30) as response:
                        return response.read()
                def create_release():
                    changelog = call("GET", "/contents/CHANGELOG.md?ref=" + urllib.parse.quote(tag), accept="application/vnd.github.raw+json").decode()
                    section = re.search(r"^## " + re.escape(version) + r"\b[^\n]*\n(.*?)(?=^## |\Z)", changelog, re.M | re.S)
                    if not section or not section.group(1).strip():
                        sys.exit(f"CHANGELOG.md at {tag} has no ## {version} section")
                    prerelease = "-rc." in version
                    call("POST", "/releases", {
                        "tag_name": tag, "name": tag, "body": section.group(1).strip() + "\n",
                        "prerelease": prerelease, "make_latest": "false" if prerelease else "true",
                    })
                    print(f"created release {tag}")
                try:
                    call("GET", "/releases/tags/" + urllib.parse.quote(tag))
                    print(f"release {tag} exists already; leaving it")
                    exists = True
                except urllib.error.HTTPError as error:
                    if error.code != 404:
                        raise
                    exists = False
                if not exists:
                    create_release()
                # The files publish built; assets that are already there stay as they are.
                workspace = "$(workspaces.source.path)"
                subprocess.run(
                    [sys.executable, "-I", workspace + "/src/scripts/ci/upload-release-assets.py",
                     tag, workspace + "/src/build/release-assets"],
                    check=True,
                    env=dict(os.environ, GITHUBGATE_REPO="{{ repo_owner }}/{{ repo_name }}"),
                )
